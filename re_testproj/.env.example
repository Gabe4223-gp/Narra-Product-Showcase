# Frontend (Create React App) — copy to .env and fill in.
# Every REACT_APP_* value is INLINED INTO THE BROWSER BUNDLE at build time.
# Never put a secret key here — publishable/public keys only.

# --- API ---
# Both must be set. REACT_APP_BASE_URL is read by src/Applications/*
# (Docs, Forms, FormBuilder, DocBuilder, EmailMessages, TenantApplications);
# everything else reads REACT_APP_API_URL. Point them at the same origin.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_BASE_URL=http://localhost:5000

# --- Auth0 (SPA application) ---
# REACT_APP_AUTH0_AUDIENCE must match AUTH0_AUDIENCE in backend/.env exactly,
# or the API will reject every token the frontend obtains.
REACT_APP_AUTH0_DOMAIN=your-tenant.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=
REACT_APP_AUTH0_AUDIENCE=http://localhost:5000

# --- Google Maps (used by src/WorkPortal.js) ---
REACT_APP_GOOGLE_MAPS_API_KEY=

# --- Payments (publishable keys only) ---
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...
REACT_APP_PAYMONGO_PUBLIC_KEY=pk_test_...
