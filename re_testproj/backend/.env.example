# Backend (Express) — copy to .env and fill in.
# Nothing here is exposed to the browser. Real secrets belong in this file only.

# --- Database ---
# Single source of truth for the DB connection. Managed Postgres (Neon,
# Supabase, Render) requires TLS — see config/config.js dialectOptions.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/narra_database

# --- Environment ---
# Set to "production" ONLY when DATABASE_URL points at the production database.
# Leaving it at "production" while pointed at localhost is what caused the
# config/models load-order bug.
NODE_ENV=development
PORT=5000

# --- URLs ---
# Origin of the deployed frontend; used for CORS and payment redirects.
FRONTEND_BASE_URL=http://localhost:3000

# --- Auth0 (API / machine-to-machine) ---
# AUTH0_AUDIENCE must match REACT_APP_AUTH0_AUDIENCE in the frontend .env.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_AUDIENCE=http://localhost:5000
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- File storage ---
# "local" writes to disk (wiped on redeploy on most free hosts).
# "aws" requires the credentials below.
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=

# --- Cache / queue ---
# Optional. Backs one 60s cache and the invoice PDF queue.
REDIS_URL=redis://127.0.0.1:6379

# --- Email (SMTP) ---
# Never hardcode these in source. See routes/sendBillRoutes.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Payments (secret keys) ---
STRIPE_SECRET_KEY=sk_test_...
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=

# --- Wise ---
WISE_API_KEY=
WISE_PROFILE_ID=
